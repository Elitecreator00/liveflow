{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "LIVEKIT_URL",
    "LIVEKIT_WS_PUBLIC_URL",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "SCENE_RENDER_BASE_URL",
    "COMPOSITE_RTMP_BASE",
    "ORCHESTRATOR_URL",
    "ORCH_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
