# LiveFlow PoC Multistream — variabili d'ambiente
# Copia in .env e personalizza prima di avviare docker compose

# ── Autenticazione ingest ─────────────────────────────────────────
# Stream key che il device deve usare nell'URL RTMP:
#   rtmp://localhost:1935/live/STREAM_KEY
STREAM_KEY=liveflow_secret

# ── Target fan-out A (es. Twitch in produzione) ───────────────────
# In questo PoC punta al container dummy locale.
# Formato: rtmp://HOST/application
TARGET_1_URL=rtmp://dummy-rtmp-1:1935/live
TARGET_1_KEY=stream1

# ── Target fan-out B (es. YouTube in produzione) ──────────────────
TARGET_2_URL=rtmp://dummy-rtmp-2:1935/live
TARGET_2_KEY=stream2

# ── Per Fase 1 (piattaforme reali — SOSTITUIRE qui) ───────────────
# TARGET_1_URL=rtmp://live.twitch.tv/app
# TARGET_1_KEY=live_XXXXXXXXXX_YYYYYYYYYYYYYYYYYYY
# TARGET_2_URL=rtmp://a.rtmp.youtube.com/live2
# TARGET_2_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
